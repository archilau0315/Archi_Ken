# ArchiKen 云端部署环境变量
# docker compose 会自动读取本文件

# === 构建标识（打包脚本会自动改写为 git hash + 时间戳） ===
ARCHIKEN_BUILD_ID=dev-local

# === L3 业务服务的 API Key（可选，默认关闭） ===
#
# 默认留空 = L3 不校验 API Key。
# 公网的访问保护靠「宝塔 Nginx 基础认证（Basic Auth）」实现 —— 因为网页的 JS
# 任何人都能下载，把 Key 编译进前端等于公开发布，起不到防护作用。
#
# 仅当你需要给「桌面端 / 内网脚本」单独加一道 Key 时，才在这里填值；
# 此时浏览器页面会取不到 Key 而返回 401，需要另配前端注入，故不推荐公网场景。
ARCHIKEN_API_KEY=

# === 内核 ===
ARCHIKEN_KERNEL_HOST=0.0.0.0
ARCHIKEN_KERNEL_PORT=4319

# === 业务服务 ===
ARCHIKEN_SERVER_HOST=0.0.0.0
ARCHIKEN_SERVER_PORT=4318
ARCHIKEN_DATA_DIR=/data
ARCHIKEN_KERNEL_URL=http://archiken-kernel:4319
