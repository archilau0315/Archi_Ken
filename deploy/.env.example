# ArchiKen 云端部署环境变量 — 复制为 .env 后按需修改
# 所有服务都读取此文件，docker-compose 自动加载

# === 构建标识（部署脚本会自动注入 git commit hash + 时间戳） ===
ARCHIKEN_BUILD_ID=dev-local

# === API Key（公网部署必须设置；留空 = 本地开发无鉴权） ===
# 建议长度 ≥ 32 字符，用随机生成器产生
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARCHIKEN_API_KEY=

# === 内核 ===
ARCHIKEN_KERNEL_HOST=0.0.0.0
ARCHIKEN_KERNEL_PORT=4319

# === 业务服务 ===
ARCHIKEN_SERVER_HOST=0.0.0.0
ARCHIKEN_SERVER_PORT=4318
ARCHIKEN_DATA_DIR=/data
ARCHIKEN_KERNEL_URL=http://archiken-kernel:4319
