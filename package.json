{
  "name": "archiken",
  "version": "0.1.0",
  "private": true,
  "description": "ArchiKen —— BIM 模型质量检查与合规审查工具（对标 Solibri）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron": "npm run build:electron && electron .",
    "server": "tsx server/index.ts",
    "kernel": "python kernel/main.py",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "koa": "^2.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
