{
  "kind": "archiken-ruleset",
  "version": 1,
  "exported_at": "2026-10-16T11:43:50",
  "name": "内置模板-疏散",
  "description": "ArchiKen 内置规则模板（疏散域，12 条），全部挂现行 GB 规范出处",
  "rules": [
    {
      "id": "egress-door-width",
      "name": "疏散门净宽",
      "name_en": "Egress Door Width",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "疏散"
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_DoorCommon",
        "prop": "OverallWidth",
        "op": ">=",
        "value": 900,
        "unit": "mm",
        "missing": "violation"
      },
      "message": "疏散门 {name} 净宽 {actual} 小于要求 {expected}",
      "message_en": "Egress door {name} width {actual} below requirement {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版) 第 5.5.18 条：疏散门净宽不应小于 0.90m）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014 Clause 5.5.18: egress door width >= 0.90m)"
    },
    {
      "id": "egress-exit-door-width",
      "name": "安全出口门净宽",
      "name_en": "Exit Door Width",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "安全出口"
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_DoorCommon",
        "prop": "OverallWidth",
        "op": ">=",
        "value": 1100,
        "unit": "mm",
        "missing": "violation"
      },
      "message": "安全出口门 {name} 净宽 {actual} 小于要求 {expected}",
      "message_en": "Exit door {name} width {actual} below requirement {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：首层疏散外门/安全出口净宽要求）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: exit door width requirement)"
    },
    {
      "id": "egress-stair-width",
      "name": "疏散楼梯净宽",
      "name_en": "Egress Stair Width",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcStair"
        ]
      },
      "check": {
        "type": "dimension",
        "axis": "min",
        "value": 1100,
        "unit": "mm"
      },
      "message": "疏散楼梯 {name} 净宽 {actual} 小于要求 {expected}",
      "message_en": "Egress stair {name} width {actual} below requirement {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版) 第 5.5.18 条：疏散楼梯净宽不应小于 1.10m）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014 Clause 5.5.18: egress stair width >= 1.10m)"
    },
    {
      "id": "egress-stairwell-headroom",
      "name": "疏散楼梯间净高",
      "name_en": "Egress Stairwell Headroom",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "疏散楼梯间"
          }
        ]
      },
      "check": {
        "type": "headroom",
        "other": {
          "ifc_type": [
            "IfcSlab",
            "IfcBeam",
            "IfcStairFlight"
          ]
        },
        "value": 2000,
        "unit": "mm"
      },
      "message": "疏散楼梯间 {name} 净高 {actual} 低于要求 {expected}",
      "message_en": "Egress stairwell {name} headroom {actual} below requirement {expected}",
      "reference": "GB 55031-2022《民用建筑通用规范》（原 GB 50352-2019：楼梯平台净高不应小于 2.00m）",
      "reference_en": "GB 55031-2022 (formerly GB 50352-2019: stair platform headroom >= 2.00m)"
    },
    {
      "id": "egress-stair-platform-width",
      "name": "楼梯平台净宽",
      "name_en": "Stair Platform Width",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "楼梯平台"
          }
        ]
      },
      "check": {
        "type": "dimension",
        "axis": "min",
        "value": 1200,
        "unit": "mm"
      },
      "message": "楼梯平台 {name} 净宽 {actual} 小于要求 {expected}",
      "message_en": "Stair platform {name} width {actual} below requirement {expected}",
      "reference": "GB 55031-2022《民用建筑通用规范》（原 GB 50352-2019：楼梯平台净宽不应小于梯段净宽且不小于 1.20m）",
      "reference_en": "GB 55031-2022 (formerly GB 50352-2019: platform width >= flight width and >= 1.20m)"
    },
    {
      "id": "egress-refuge-room-min",
      "name": "避难间最小尺寸",
      "name_en": "Refuge Room Min Size",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "避难"
          }
        ]
      },
      "check": {
        "type": "dimension",
        "axis": "min",
        "value": 2000,
        "unit": "mm"
      },
      "message": "避难空间 {name} 短边 {actual} 小于要求 {expected}",
      "message_en": "Refuge space {name} short side {actual} below requirement {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：避难间（层）设置要求）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: refuge room/floor requirements)"
    },
    {
      "id": "egress-fire-door-rating",
      "name": "疏散路径防火门等级",
      "name_en": "Egress Fire Door Rating",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "防火门"
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_DoorCommon",
        "prop": "FireRating",
        "op": "exists"
      },
      "message": "防火门 {name} 未定义防火等级（疏散路径关键构件）",
      "message_en": "Fire door {name} missing fire rating (critical on egress route)",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：防火门设置要求）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: fire door requirements)"
    },
    {
      "id": "egress-door-operation-defined",
      "name": "疏散门开启方式定义",
      "name_en": "Egress Door Operation Type",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "疏散"
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_DoorCommon",
        "prop": "OperationType",
        "op": "exists"
      },
      "message": "疏散门 {name} 未定义开启方式（应能判定是否向疏散方向开启）",
      "message_en": "Egress door {name} missing operation type (needed to verify swing direction)",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：疏散门应向疏散方向开启；数据前提）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: egress doors shall open in exit direction; data prerequisite)"
    },
    {
      "id": "egress-corridor-no-pipe",
      "name": "疏散走道管线穿越",
      "name_en": "No Pipes Crossing Egress Corridor",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "疏散走道"
          }
        ]
      },
      "check": {
        "type": "intersection",
        "other": {
          "ifc_type": [
            "IfcPipeSegment"
          ]
        }
      },
      "message": "疏散走道 {name} 与管线 {related.name} 相交，存在管线穿越",
      "message_en": "Egress corridor {name} intersects pipe {related.name}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：疏散走道内不应设置影响疏散的管线）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: no obstructing pipes in egress corridors)"
    },
    {
      "id": "egress-wall-fire-rating",
      "name": "疏散路径隔墙防火等级",
      "name_en": "Egress Partition Fire Rating",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcWall"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "疏散"
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_WallCommon",
        "prop": "FireRating",
        "op": "exists"
      },
      "message": "疏散路径隔墙 {name} 未定义防火等级",
      "message_en": "Egress partition {name} missing fire rating",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：疏散走道隔墙耐火极限要求）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: egress corridor wall fire resistance)"
    },
    {
      "id": "egress-exit-door-spacing",
      "name": "安全出口分散布置间距",
      "name_en": "Exit Door Spacing",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "安全出口"
          }
        ]
      },
      "check": {
        "type": "clearance",
        "other": {
          "ifc_type": [
            "IfcDoor"
          ],
          "where": [
            {
              "attr": "Name",
              "op": "contains",
              "value": "安全出口"
            }
          ]
        },
        "axis": "all",
        "value": 5000,
        "unit": "mm"
      },
      "message": "安全出口 {name} 与 {related.name} 间距 {actual} 小于分散布置要求 {expected}",
      "message_en": "Exit door {name} to {related.name} spacing {actual} below required {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版) 第 5.5.2 条：相邻两个安全出口最近边缘之间的水平距离不应小于 5m）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014 Clause 5.5.2: adjacent exits ≥ 5m apart)"
    },
    {
      "id": "egress-exit-door-count-per-storey",
      "name": "每层安全出口数量",
      "name_en": "Exit Doors per Storey",
      "category": "疏散",
      "category_en": "Evacuation",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ],
        "where": [
          {
            "attr": "Name",
            "op": "contains",
            "value": "安全出口"
          }
        ]
      },
      "check": {
        "type": "count",
        "group_by": "storey",
        "op": ">=",
        "value": 2
      },
      "message": "{name} 安全出口数量 {actual} 不满足 {expected}",
      "message_en": "{name}: exit door count {actual} does not satisfy {expected}",
      "reference": "GB 55037-2022《建筑防火通用规范》（原 GB 50016-2014(2018年版)：每个防火分区或楼层安全出口不应少于 2 个；按名称关键词统计，待按项目复核）",
      "reference_en": "GB 55037-2022 (formerly GB 50016-2014: ≥2 exits per compartment/storey; keyword-based count)"
    }
  ]
}