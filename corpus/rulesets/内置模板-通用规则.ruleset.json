{
  "kind": "archiken-ruleset",
  "version": 1,
  "exported_at": "2026-10-16T11:43:50",
  "name": "内置模板-通用规则",
  "description": "ArchiKen 内置规则模板（通用规则域，15 条），全部挂现行 GB 规范出处",
  "rules": [
    {
      "id": "clash-interdisciplinary",
      "name": "跨专业碰撞",
      "name_en": "Interdisciplinary Clash",
      "category": "碰撞检查",
      "category_en": "Clash Detection",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcWall"
        ]
      },
      "check": {
        "type": "intersection",
        "other": {
          "ifc_type": [
            "IfcDuctSegment"
          ]
        }
      },
      "message": "墙体 {name} 与风管 {related_name} 发生碰撞",
      "message_en": "Wall {name} clashes with duct {related_name}"
    },
    {
      "id": "door-min-width",
      "name": "门洞宽度小于 900 提示",
      "name_en": "Door Overall Width Below 900",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ]
      },
      "check": {
        "type": "property",
        "attr": "OverallWidth",
        "op": ">=",
        "value": 900,
        "unit": "mm",
        "missing": "violation"
      },
      "message": "门 {name} 门洞总宽 {actual} 小于 900（OverallWidth 为门洞总宽，净宽要求请按 GB 55019 结合门型复核）",
      "message_en": "Door {name} overall width {actual} below 900 (OverallWidth is opening width; verify clear width per GB 55019 by door type)"
    },
    {
      "id": "beam-slab-headroom",
      "name": "梁板净空",
      "name_en": "Beam-Slab Headroom",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcBeam"
        ]
      },
      "check": {
        "type": "clearance",
        "other": {
          "ifc_type": [
            "IfcSlab"
          ]
        },
        "axis": "z",
        "value": 2400,
        "unit": "mm"
      },
      "message": "梁 {name} 与楼板 {related_name} 垂直净空 {actual} 低于 {expected}",
      "message_en": "Beam {name} to slab {related_name} vertical clearance {actual} below {expected}"
    },
    {
      "id": "duplicate-member",
      "name": "重复构件",
      "name_en": "Duplicate Element",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "*"
        ]
      },
      "check": {
        "type": "duplicate",
        "size_tolerance": 0.02,
        "center_tolerance": 0.05
      },
      "message": "构件 {name} 与 {related_name} 外形一致且中心重合，疑似重复",
      "message_en": "Element {name} and {related_name} have identical shape and center, suspected duplicate"
    },
    {
      "id": "pipe-min-spacing",
      "name": "管道最小间距",
      "name_en": "Pipe Min Spacing",
      "category": "施工可行性",
      "category_en": "Constructability",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcPipeSegment"
        ]
      },
      "check": {
        "type": "clearance",
        "other": {
          "ifc_type": [
            "IfcPipeSegment"
          ]
        },
        "axis": "all",
        "value": 100,
        "unit": "mm"
      },
      "message": "管道 {name} 与 {related_name} 间距 {actual} 小于 {expected}",
      "message_en": "Pipe {name} to {related_name} spacing {actual} below {expected}"
    },
    {
      "id": "window-required-fire-rating",
      "name": "窗防火等级必填",
      "name_en": "Window Fire Rating Required",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcWindow"
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_WindowCommon",
        "prop": "FireRating",
        "op": "exists"
      },
      "message": "窗 {name} 缺少防火等级（FireRating）",
      "message_en": "Window {name} missing fire rating (FireRating)"
    },
    {
      "id": "door-required-handicap",
      "name": "门无障碍标识",
      "name_en": "Door Accessibility Flag",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcDoor"
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_DoorCommon",
        "prop": "HandicapAccessible",
        "op": "==",
        "value": true
      },
      "message": "门 {name} 未标记为无障碍门",
      "message_en": "Door {name} not marked as accessible"
    },
    {
      "id": "external-wall-fire-rating",
      "name": "外墙防火等级必填",
      "name_en": "External Wall Fire Rating Required",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcWall"
        ],
        "where": [
          {
            "pset": "Pset_WallCommon",
            "prop": "IsExternal",
            "op": "==",
            "value": true
          }
        ]
      },
      "check": {
        "type": "property",
        "pset": "Pset_WallCommon",
        "prop": "FireRating",
        "op": "exists"
      },
      "message": "外墙 {name} 缺少防火等级（FireRating）",
      "message_en": "External wall {name} missing fire rating (FireRating)"
    },
    {
      "id": "member-naming-convention",
      "name": "构件命名规范",
      "name_en": "Element Naming Convention",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcMember",
          "IfcColumn",
          "IfcBeam"
        ]
      },
      "check": {
        "type": "property",
        "attr": "Name",
        "op": "matches",
        "value": "^[A-Za-z]"
      },
      "message": "构件 {name} 命名不符合「以字母开头」的规范",
      "message_en": "Element {name} naming does not comply with 'starts with letter' convention"
    },
    {
      "id": "duct-slab-clearance",
      "name": "风管楼板净空",
      "name_en": "Duct-Slab Clearance",
      "category": "合规检查",
      "category_en": "Compliance",
      "severity": "warning",
      "target": {
        "ifc_type": [
          "IfcDuctSegment"
        ]
      },
      "check": {
        "type": "clearance",
        "other": {
          "ifc_type": [
            "IfcSlab"
          ]
        },
        "axis": "z",
        "value": 200,
        "unit": "mm"
      },
      "message": "风管 {name} 与楼板 {related_name} 垂直净空 {actual} 低于 {expected}",
      "message_en": "Duct {name} to slab {related_name} vertical clearance {actual} below {expected}"
    },
    {
      "id": "wall-window-intersection",
      "name": "墙窗几何相交",
      "name_en": "Wall-Window Intersection",
      "category": "碰撞检查",
      "category_en": "Clash Detection",
      "severity": "error",
      "target": {
        "ifc_type": [
          "IfcWall"
        ]
      },
      "check": {
        "type": "intersection",
        "other": {
          "ifc_type": [
            "IfcWindow"
          ]
        }
      },
      "message": "墙体 {name} 与窗 {related_name} 发生几何相交",
      "message_en": "Wall {name} geometrically intersects window {related_name}"
    },
    {
      "id": "pipe-duplicate",
      "name": "管道重复建模",
      "name_en": "Duplicate Pipe",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcPipeSegment"
        ]
      },
      "check": {
        "type": "duplicate",
        "size_tolerance": 0.02,
        "center_tolerance": 0.05
      },
      "message": "管道 {name} 与 {related_name} 外形一致且中心重合，疑似重复",
      "message_en": "Pipe {name} and {related_name} have identical shape and center, suspected duplicate"
    },
    {
      "id": "quality-space-area-defined",
      "name": "空间面积属性完整性",
      "name_en": "Space Area Property",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ]
      },
      "check": {
        "type": "property",
        "pset": "Qto_SpaceBaseQuantities",
        "prop": "NetFloorArea",
        "op": "exists"
      },
      "message": "空间 {name} 缺少 NetFloorArea 面积属性（面积类规则生效前提）",
      "message_en": "Space {name} missing NetFloorArea (prerequisite for area rules)"
    },
    {
      "id": "quality-storey-naming",
      "name": "楼层命名规范性",
      "name_en": "Storey Naming Convention",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcBuildingStorey"
        ]
      },
      "check": {
        "type": "property",
        "attr": "Name",
        "op": "matches",
        "value": "(B\\d+|\\d+F|F\\d+|\\d+层|Level|[Gg]round)"
      },
      "message": "楼层 {name} 命名不符合约定格式（示例：B1 / 1F / F1 / 1层 / Level 1 / groundfloor）",
      "message_en": "Storey {name} naming outside convention (e.g. B1 / 1F / F1 / Level 1 / groundfloor)"
    },
    {
      "id": "model-has-spaces",
      "name": "模型应包含空间",
      "name_en": "Model Should Have Spaces",
      "category": "模型质量",
      "category_en": "Model Quality",
      "severity": "info",
      "target": {
        "ifc_type": [
          "IfcSpace"
        ]
      },
      "check": {
        "type": "count",
        "op": ">=",
        "value": 1
      },
      "message": "模型中未找到任何 IfcSpace 空间构件，空间/面积/净高类规则无法生效",
      "message_en": "No IfcSpace found in model; space/area/headroom rules cannot take effect"
    }
  ]
}